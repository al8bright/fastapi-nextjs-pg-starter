# 백엔드 환경변수 — 실제 값은 .env 에 채우고 커밋하지 않는다 (architecture.md §5, §17)

# DB (psql 로 생성한 데이터베이스)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/__PROJECT_SNAKE__

# 실행 환경 — production 이면 안전하지 않은 기본값(기본 SECRET_KEY, 관리자 시드)으로 기동하지 않는다.
APP_ENV=development

# JWT — ⛔ 아래 값은 저장소에 공개된 기본값이다. 반드시 무작위 키로 교체한다.
#        openssl rand -hex 24   (scaffold.sh 는 자동으로 무작위 키를 넣어준다)
SECRET_KEY=change-me-in-production-use-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (콤마 구분)
CORS_ORIGINS=http://localhost:3000

# URL
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# 실행 시각대 (KST 고정 — config 로드 시 프로세스에 반영, Windows 는 tzset 미지원이라 OS 설정 필요)
TZ=Asia/Seoul

# 초기 시드 — 기본 관리자(admin) 자동 생성. 코드 기본값은 꺼져 있고(config.py), 여기서만 켠다.
# ⛔ APP_ENV=production 에서 true 면 기동을 거부한다. 운영에서는 관리자 계정을 직접 만든다.
# DEFAULT_ADMIN_PASSWORD 는 비워 둘 수 없다(비면 시드를 건너뛰고 에러 로그를 남긴다).
# UTF-8 기준 72 bytes 이하여야 한다 (bcrypt 상한, 한글은 글자당 3 bytes → 24자까지).
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_PASSWORD=
