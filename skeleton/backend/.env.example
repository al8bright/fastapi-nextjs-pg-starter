# 백엔드 환경변수 — 실제 값은 .env 에 채우고 커밋하지 않는다 (architecture.md §5, §17)

# DB (psql 로 생성한 데이터베이스)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/__PROJECT_SNAKE__

# JWT
SECRET_KEY=change-me-in-production-use-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (콤마 구분)
CORS_ORIGINS=http://localhost:3000

# URL
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# 실행 시각대 (KST 고정 — config 로드 시 프로세스에 반영, Windows 는 tzset 미지원이라 OS 설정 필요)
TZ=Asia/Seoul

# 초기 시드 — 기본 관리자(admin) 자동 생성. 운영에서는 false 로 끄거나 초기 비밀번호를 변경한다.
# DEFAULT_ADMIN_PASSWORD 는 UTF-8 기준 72 bytes 이하여야 한다 (bcrypt 상한, 한글은 글자당 3 bytes
# → 24자까지). 초과하면 시드가 실패하고 기동 로그에 남는다.
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_PASSWORD=admin123
