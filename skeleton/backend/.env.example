# 백엔드 환경변수 — 실제 값은 .env 에 채우고 커밋하지 않는다 (ARCHITECTURE.md §5, §17)

# DB (psql 로 생성한 데이터베이스)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/__PROJECT_SNAKE__

# 실행 환경 — production 이면 안전하지 않은 기본값(기본 SECRET_KEY, 관리자 시드, Secure 없는 refresh 쿠키)으로 기동하지 않는다.
APP_ENV=development

# JWT — ⛔ 아래 값은 저장소에 공개된 기본값이다. 반드시 무작위 키로 교체한다.
#        openssl rand -hex 24   (scaffold.sh 는 자동으로 무작위 키를 넣어준다)
SECRET_KEY=change-me-in-production-use-32-bytes
# access 는 짧게(탈취 창 축소) — 갱신은 DB 세션 기반 refresh 토큰(/auth/refresh)이 담당한다.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# 로그인 시도 제한 — 계정별 연속 실패가 MAX 이상이면 LOCKOUT 분 동안 429 로 거부한다.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# refresh 토큰 전달 방식 (ARCHITECTURE.md §9) — cookie | body (코드 기본값은 cookie)
# - cookie: 백엔드가 httpOnly 쿠키(path=/api/v1/auth)로 직접 심는다. 브라우저 SPA(React/Nuxt/SvelteKit) 용.
# - body:   JSON 본문으로 주고받는다. BFF(Next.js 서버)가 받아 자기 httpOnly 쿠키에 보관하는 구조 전용.
# 이 템플릿(Next.js BFF)은 body 를 쓴다.
REFRESH_TOKEN_TRANSPORT=body
# refresh 쿠키의 Secure 속성 (cookie 모드에서만 의미). HTTPS 운영에서는 반드시 true —
# ⛔ APP_ENV=production + REFRESH_TOKEN_TRANSPORT=cookie 에서 false 면 기동을 거부한다.
COOKIE_SECURE=false

# CORS (콤마 구분)
CORS_ORIGINS=http://localhost:3000

# URL
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# 업로드 저장소 — 상대 경로는 backend 디렉터리 기준(기본 uploads → backend/uploads, .gitignore 대상).
# public/ 아래(에디터·배너 이미지)만 /uploads/public 으로 정적 서빙되고, private/(공지 첨부)는 API 로만 내려간다.
UPLOAD_DIR=uploads
# 응답에 담는 공개 파일·첨부 다운로드 URL 의 접두사. 비우면 루트 상대 경로(/uploads/public/...)다.
# - 이 템플릿(Next.js BFF)은 비워 둔다 — Next 가 /uploads/* 와 공개 첨부 다운로드 경로를 같은 오리진에서
#   백엔드로 rewrite 한다(frontend/next.config.ts). 브라우저는 백엔드 주소를 알 필요가 없다.
# - 공개 파일을 CDN 등 다른 오리진에서 내보낼 때만 그 주소를 넣는다 (frontend CSP img-src 도 함께 연다).
PUBLIC_FILES_BASE_URL=
# 업로드 크기 상한(MB) — 이미지(에디터·배너) / 공지 첨부
# ⚠️ 올리면 frontend/next.config.ts 의 Server Action 본문 상한(serverActions.bodySizeLimit)도 함께 올린다.
MAX_IMAGE_UPLOAD_MB=5
MAX_ATTACHMENT_UPLOAD_MB=20

# 실행 시각대 (KST 고정 — config 로드 시 프로세스에 반영, Windows 는 tzset 미지원이라 OS 설정 필요)
TZ=Asia/Seoul

# 초기 시드 — 기본 관리자(admin) 자동 생성. 코드 기본값은 꺼져 있고(config.py), 여기서만 켠다.
# ⛔ APP_ENV=production 에서 true 면 기동을 거부한다. 운영에서는 관리자 계정을 직접 만든다.
# DEFAULT_ADMIN_PASSWORD 는 비워 둘 수 없다(비면 시드를 건너뛰고 에러 로그를 남긴다).
# UTF-8 기준 72 bytes 이하여야 한다 (bcrypt 상한, 한글은 글자당 3 bytes → 24자까지).
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_PASSWORD=
