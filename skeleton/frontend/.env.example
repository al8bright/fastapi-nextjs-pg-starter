# 프론트엔드 환경변수 — 실제 값은 .env 에 채우고 커밋하지 않는다 (architecture.md §17)
#
# ⛔ NEXT_PUBLIC_ 접두를 붙이지 마라.
#    이 스타터에서 FastAPI 를 호출하는 쪽은 **브라우저가 아니라 Next 서버**다
#    (서버 컴포넌트 / Server Action / proxy). NEXT_PUBLIC_ 을 붙이면 값이
#    클라이언트 번들에 인라인되어 내부 API 주소가 그대로 노출된다.
FASTAPI_URL=http://localhost:8000

# 백엔드 응답 대기 상한(ms, 선택). 미설정 시 10000.
# 연결 거부는 즉시 실패하지만, 응답하지 않는 백엔드는 이 값이 없으면 SSR 렌더를 오래 붙잡는다.
FASTAPI_TIMEOUT_MS=10000
